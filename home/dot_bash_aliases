# NetworkManager restart (systemd/systemctl - Arch, not the old sysvinit
# `service` command)
alias fix-wifi='sudo systemctl restart NetworkManager && echo "Restarted NetworkManager"'
alias wifi-restart='sudo systemctl restart NetworkManager && echo "Restarted NetworkManager"'

# emacsclient shortcuts - all talk to the single systemd-managed Emacs
# daemon (see CHEZMOI-GUIDE.md and ~/.config/systemd/user/emacs.service).
# The void string passed to -a is IMPORTANT: it means "auto-start the
# daemon if it's not already running" rather than falling back to a
# separate, non-daemon Emacs process - matters mainly before first boot/
# apply, since systemd normally keeps the daemon running from login onward.
alias ec="emacsclient -cnqua ''"       # new GUI frame, don't wait, quiet, no output
alias emax="emacsclient -t -a ''"      # new frame in this terminal (text mode)
# was `sudo emacsclient -t`, which doesn't work as written - there's no
# separate root-owned daemon for it to connect to. This edits root-owned
# files via TRAMP instead, through the *same* user daemon - no sudo needed.
alias semacs="emacsclient -t /sudo::"
# cleanly kill the daemon - since every emacsclient frame/terminal is just
# a connection to this one process, this closes all of them at once.
alias ekill='emacsclient --eval "(kill-emacs)"'
alias fzfi='rg --files --hidden --follow --no-ignore-vcs -g "!{node_modules,.git}" 2> /dev/null|fzf'
alias et='emacsclient -t $(fzfi)'

alias cdtemp='cd $(mktemp -d)'
alias rmtrash='trash-put'  # needs the trash-cli package

alias df="df -ha"
alias du="du -ach | sort -h"
alias free="free -t --mega"
alias psgrep="ps aux | grep -v grep | grep"
alias mount='mount |column -t'
alias mnt="mount | awk -F' ' '{ printf \"%s\t%s\n\",\$1,\$3; }' | column -t | egrep ^/dev/ | sort"
# was `gh` in the old dotfiles - renamed, `gh` is now the actual GitHub CLI
# (mise-managed, see install-dev-stack.sh)
alias ghist='history|grep'

# git shortcuts (typed bare, e.g. `gs` - distinct from git's own [alias]
# section in .gitconfig, which you'd invoke as `git s`)
alias gs="git status -sb"
alias gal="git add ."
alias gca="git commit -a -m"
alias gcot="git checkout"
alias gpo="git push -u origin"
alias stash="git stash"
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"

# -------------------------------------
# Chezmoi & Bitwarden Automation Aliases
# -------------------------------------
alias cz="chezmoi"
alias cza="chezmoi apply"
alias czd="chezmoi diff"
alias czs="chezmoi status"
alias czcd="chezmoi cd"
alias czp="chezmoi preview"
alias czup='export BW_SESSION=$(bw unlock --raw) && chezmoi apply'
alias cze="chezmoi edit"
alias czsync="chezmoi git pull -- --autostash && chezmoi apply"
alias czpush='cz git add . && cz git commit -- -m "Update dotfiles" && cz git push'
