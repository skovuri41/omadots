# .chezmoiignore - files/dirs chezmoi should not manage.

# ~/.ssh, host "aditya" only: the private key is templated from Bitwarden,
# which forces a vault unlock on every diff/status/apply even though the
# key never changes. Ignored on this host only - a fresh machine
# bootstrapped from this repo still gets the key populated once.
{{- if eq .chezmoi.hostname "aditya" }}
.ssh
.config/mise/config.toml
.config/foot/foot.ini
{{- end }}

# ~/.config/bws/access-token holds the live Bitwarden Secrets Manager
# machine-account token (see README.md's "Secrets" section) - never
# chezmoi-managed, on any host. Second-layer backstop in the root
# .gitignore in case a copy ever lands in the tree some other way.
.config/bws/access-token

# ~/.claude (Claude Code's own config dir) is a default-DENY allowlist, not
# a named block-list, because it holds a live OAuth credential
# (.credentials.json) alongside portable config (settings.json, themes).
# Everything else under ~/.claude - history/transcripts, plugin cache,
# auto-generated wrapper scripts, herdr's own hook script, Omarchy's
# symlinked skills - is app/session state or someone else's content, not
# hand-authored config, so it stays ignored by default. A future Claude
# Code version adding some new file here is excluded automatically too,
# instead of getting swept in by an accidental `chezmoi add -r ~/.claude`.
.claude/**
!.claude
!.claude/settings.json
!.claude/themes
!.claude/themes/**
# Not a `.claude/skills/**` wildcard allow, on purpose - skills/
# diagnose-crash and skills/omarchy are Omarchy's own symlinked package
# content and should stay ignored by default like everything else here.
# Only specific personal skills (see README.md's "Agent skills" section)
# get un-ignored, one line per skill.
!.claude/skills
!.claude/skills/clojure-style
