# Simple calculator
function calc() {
  local result=""
  result="$(printf "scale=10;$*\n" | bc --mathlib | tr -d '\\\n')"
  if [[ "$result" == *.* ]]; then
    printf "$result" |
      sed -e 's/^\./0./' -e 's/^-\./-0./' -e 's/0*$//;s/\.$//'
  else
    printf "$result"
  fi
  printf "\n"
}

# Create a new directory and enter it
function mkd() {
  mkdir -p "$@" && cd "$_"
}

# Determine size of a file or total size of a directory
function fs() {
  local arg=-sbh
  du "$arg" -- "${@:-.[^.]* *}"
}

# Use Git's colored diff when available. NOTE: this shadows coreutils
# `diff` in this interactive shell - `git diff --no-index` doesn't support
# standard diff flags like `-r`/`-y`; use `command diff` for those.
if hash git &>/dev/null; then
  function diff() {
    git diff --no-index --color-words "$@"
  }
fi

# `du` alone gives the friendly sorted summary; `du <args>` forwards to the
# real du. (Used to be an alias - aliases append typed args to the *end* of
# their expansion, not into the first command, so `du ~/Downloads` silently
# ran `du -ach | sort -h ~/Downloads` instead of doing what you'd expect.)
function du() {
  if [ $# -eq 0 ]; then
    command du -ach | sort -h
  else
    command du "$@"
  fi
}

# same fix as `du` above - `mount` alone still pipes through column -t,
# `mount <args>` (e.g. mounting/unmounting something) forwards untouched
function mount() {
  if [ $# -eq 0 ]; then
    command mount | column -t
  else
    command mount "$@"
  fi
}

# real `hd` if one's on PATH, hexdump -C fallback otherwise - forwards args
# either way (the old alias silently discarded them when a real `hd` existed)
function hd() {
  if command -v hd >/dev/null 2>&1; then
    command hd "$@"
  else
    hexdump -C "$@"
  fi
}

# Create a data URL from a file
function dataurl() {
  local mimeType
  mimeType=$(file -b --mime-type "$1")
  [[ $mimeType == text/* ]] && mimeType="${mimeType};charset=utf-8"
  echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')"
}

# Start an HTTP server from a directory, optionally specifying the port
function server() {
  local port="${1:-8000}"
  xdg-open "http://localhost:${port}/" &>/dev/null &
  python3 -m http.server "$port"
}

# Compare original and gzipped file size
function gz() {
  local origsize gzipsize ratio
  origsize=$(wc -c <"$1")
  gzipsize=$(gzip -c "$1" | wc -c)
  ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l)
  printf "orig: %d bytes\n" "$origsize"
  printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio"
}

# Syntax-highlight JSON strings or files
function json() {
  if [ -t 0 ]; then
    python3 -m json.tool <<<"$*"
  else
    python3 -m json.tool
  fi
}

# Run `dig` and display the most useful info
function digga() {
  dig +nocmd "$1" any +multiline +noall +answer
}

# `v` with no arguments opens the current directory in vim
function v() {
  if [ $# -eq 0 ]; then vim .; else vim "$@"; fi
}

# `o` with no arguments opens the current directory in the default file
# manager/app (xdg-open - the Linux equivalent of macOS `open`)
function o() {
  if [ $# -eq 0 ]; then xdg-open .; else xdg-open "$@"; fi
}

function ediff() {
  if [ -z "$2" ]; then
    echo "USAGE: ediff <FILE 1> <FILE 2>"
  else
    emacsclient -c --eval "(ediff-files \"$1\" \"$2\")"
  fi
}

# --- Emacs / emacsclient reliability ------------------------------------
#
# `ec`/`emax` used to call `emacsclient -a ''` directly, and
# `ALTERNATE_EDITOR=""` (used to be exported in dot_bash_exports) meant
# every OTHER emacsclient call - git's core.editor, $EDITOR/$VISUAL, the
# `magit`/`et` aliases, `ediff` above - got the same behavior implicitly,
# since emacsclient reads $ALTERNATE_EDITOR whenever `-a`/`-s` isn't
# passed explicitly.
#
# That's the confirmed root cause of "a new daemon sometimes appears
# instead of connecting to the systemd one": per emacsclient's own source
# (lib-src/emacsclient.c, set_socket()/fail()), `-a ''` unconditionally
# forks a brand-new `emacs --daemon` the instant ANY connection attempt
# fails - a still-starting daemon (Doom's packages take a moment to load),
# a mid-restart window (the unit has Restart=on-failure), a transient
# hiccup - with no check for "is a daemon already on its way up." Whoever
# wins the race to call `(server-start)` first keeps the socket; the loser
# just logs a warning to its own *Messages* buffer and sits there as an
# orphan process forever, untracked by systemd. Do that enough times and
# you get exactly the reported symptom, with `systemctl --user status`
# innocently showing "active" the whole time (it's tracking the ORIGINAL
# daemon's PID, which may or may not still own the socket).
#
# Fix: nothing except systemd is allowed to start `emacs --daemon` now
# (the global ALTERNATE_EDITOR export is gone). This wrapper is the one
# place allowed to *ask* systemd to start it, and only after confirming
# the client genuinely can't connect - so at most one daemon ever exists.
emacsclient_safe() {
  if emacsclient --eval '(+ 1 1)' &>/dev/null; then
    emacsclient "$@"
    return
  fi

  local state
  state=$(systemctl --user is-active emacs.service 2>/dev/null)
  case "$state" in
    activating | reloading)
      : # already coming up - wait below instead of racing it
      ;;
    active)
      : # systemd thinks it's fine but we couldn't connect yet - wait it out
      ;;
    *)
      echo "emacsclient_safe: emacs.service is '$state' - starting it" >&2
      systemctl --user start emacs.service
      ;;
  esac

  local i
  for i in $(seq 1 20); do
    if emacsclient --eval '(+ 1 1)' &>/dev/null; then
      emacsclient "$@"
      return
    fi
    sleep 0.5
  done

  echo "emacsclient_safe: emacs.service still unreachable after 10s" \
    "(state: $(systemctl --user is-active emacs.service 2>/dev/null))." >&2
  echo "Check: estatus / elog (see dot_bash_aliases)" >&2
  return 1
}

# New GUI frame, don't wait, quiet, no output - was `alias ec="emacsclient
# -cnqua ''"`, now routed through emacsclient_safe instead of emacsclient's
# own auto-start (see the comment above emacsclient_safe for why).
ec() {
  emacsclient_safe -cnqu "$@"
}

# New frame in this terminal (text mode) - was `alias emax="emacsclient -t
# -a ''"`, same reasoning as ec() above.
emax() {
  emacsclient_safe -t "$@"
}

function findit {
  local START_PATH='.'
  local FILES="$*"
  if echo "$1" | grep '\.\.' >/dev/null; then
    set -- $(echo "$1" | sed 's/\/*\.\.\/*/  /')
  fi
  if [ -d "$1" ] && [ -n "$2" ]; then
    START_PATH=$1
    shift
    FILES="$*"
  fi
  find "$START_PATH" \
    -not \( -path '*classes*' -or -path '*node_modules*' -or -path '*/.git*' \) \
    -and -iname "$(perl -e 'print join " -o -iname ", @ARGV' "$FILES")"
}

function xtitle {
  case "$1" in
    -t) shift; echo "\e]1;$*\a" ;;
    -w) shift; echo "\e]2;$*\a" ;;
    -b) shift; echo "\e]0;$*\a" ;;
    *)  echo "\e]0;$*\a" ;;
  esac
}

# Fuzzy-pick a branch and check it out
gch() {
  git checkout "$(git branch --all | fzf | tr -d '[:space:]')"
}

# yt-dlp helpers (yt-dlp, not youtube-dl - it's the maintained fork and is
# already in Omarchy's base packages)
mp3() {
  yt-dlp --ignore-errors -f bestaudio --extract-audio --audio-format mp3 --audio-quality 0 -o '%(title)s.%(ext)s' "$1"
}
mp3p() {
  yt-dlp --ignore-errors --sleep-interval 30 -i -f bestaudio --extract-audio --audio-format mp3 --audio-quality 0 -o '%(playlist)s/%(playlist_index)s - %(title)s.%(ext)s' "$1"
}
dlv() {
  yt-dlp --ignore-errors -o '%(title)s.%(ext)s' "$1"
}
dlp() {
  yt-dlp --yes-playlist --ignore-errors --sleep-interval 30 -o '%(playlist)s/%(title)s.%(ext)s' "$1"
}

# Unlock the Bitwarden vault once per shell and export the session, so
# chezmoi's `bitwarden.unlock = "auto"` (see home/.chezmoi.toml.tmpl) stops
# re-prompting for the master password on every `chezmoi diff`/`status`/
# `apply`. Each of those is a fresh process and can't see a BW_SESSION set
# by a previous chezmoi run - only one exported in this shell already.
bwu() {
  if [ "$(bw status --raw 2>/dev/null | jq -r .status)" = "unlocked" ]; then
    echo "bw: already unlocked in this shell"
    return
  fi
  export BW_SESSION="$(bw unlock --raw)"
}
