# XDG_CONFIG_HOME, exported explicitly (added 2026-09-06) rather than left
# for each tool to assume its own default. Most tools on this machine
# already resolve to $HOME/.config on their own when this is unset - mise,
# chezmoi, gh, and bw were each checked directly against their own docs/
# source and all implement the full XDG Base Directory fallback themselves
# (mise: `${XDG_CONFIG_HOME:-$HOME/.config}/mise`; bw's `bw.ts` literally
# has `XDG_CONFIG_HOME ?? path.join(HOME, ".config/Bitwarden CLI")`) - so
# exporting this is a genuine no-op for all of them. The one tool where it
# is NOT a no-op: the Clojure CLI's own script resolves its user config dir
# as `$CLJ_CONFIG -> $XDG_CONFIG_HOME/clojure -> $HOME/.clojure` (confirmed
# from clojure.org's CLI reference) - unset, it skips `~/.config` entirely
# and goes straight to the legacy `~/.clojure`, which is why the
# `clojure-deps-edn` external in `.chezmoiexternal.toml` now targets
# `.config/clojure` instead. Maven (`~/.m2`) and npm (`~/.npmrc`) don't
# check this variable at all (confirmed via Maven's own still-open XDG
# feature request, MNG-6603, and npm's docs) - unaffected either way.
# Deliberately placed here (`dot_bash_exports`, sourced by `dot_bashrc` for
# every interactive shell) rather than `dot_bash_profile` - a login-shell-
# only export would silently miss every Hyprland/uwsm-launched terminal
# shell, which is non-login (same class of bug flagged for `nocaseglob`
# elsewhere in this repo's history).
#
# This only ever reached bash-launched processes, though - not a GUI app
# spawned directly by Hyprland (app launcher, keybinding `exec`, autostart
# entries). That gap is now closed at the source instead: as of the same
# day, `dot_config/hypr/envs.lua` sets all four standard XDG Base
# Directories (CONFIG/CACHE/DATA/STATE_HOME) directly in Hyprland's own
# process environment via `hl.env(...)`, so every child Hyprland spawns
# inherits them regardless of whether bash is in the picture - see that
# file's header comment and CHEZMOI-GUIDE.md's XDG_CONFIG_HOME section for
# the full writeup. This export is kept anyway since it's still the only
# one of the two that reaches a bash shell opened outside Hyprland
# entirely (SSH into this machine, a bare TTY login, cron) - setting the
# same value twice, here and in Hyprland, is a harmless no-op.
export XDG_CONFIG_HOME="$HOME/.config"

# Prefer US English and use UTF-8.
export LANG='en_US.UTF-8'
export LC_ALL='en_US.UTF-8'

# Don't clear the screen after quitting a manual page.
export MANPAGER='less -X'

# Editors - Doom Emacs via emacsclient, talking to the single
# systemd-managed daemon (~/.config/systemd/user/emacs.service).
#
# Deliberately NOT exporting ALTERNATE_EDITOR anymore. It used to be set
# to "" here, which - since emacsclient reads that env var whenever no
# explicit -a/-s flag is given - made EVERY emacsclient call below (plus
# git's core.editor, the `magit`/`et`/`ediff` helpers) silently fork a
# brand-new `emacs --daemon` on any connection failure, racing whatever
# daemon systemd already had running. That's the confirmed root cause of
# "a second Emacs daemon sometimes appears" - full writeup on
# emacsclient_safe() in dot_bash_functions, which is now the only place
# allowed to ask systemd to (re)start the real daemon. Without it, a
# failed connection here just errors loudly ("Have you started the
# server?") instead of quietly multiplying - if you see that, run `estart`
# (dot_bash_aliases) and try again.
export EDITOR="emacsclient -t"
export VISUAL="emacsclient -c"

prepend_path() {
  export PATH="$1:${PATH}"
}

# ~/.local/bin (poly, mise-installed CLI stubs, etc.) and Doom's bin - Omarchy's
# /etc/profile already adds ~/.local/bin for most login setups, but this makes
# it explicit and covers ~/.config/emacs/bin too.
prepend_path "${HOME}/.local/bin"
prepend_path "${HOME}/.config/emacs/bin"

# babashka bbin-installed scripts, if you're using bbin
prepend_path "${HOME}/.babashka/bbin/bin"

# Extra PATH entries added by install-dev-stack.sh for custom (non-pacman/
# AUR/mise) installs - e.g. Doom Emacs's bin dir. That script writes and
# maintains this file itself, idempotently; it's never hand-edited and
# never chezmoi-managed (chezmoi would overwrite it from source state on
# every apply, dropping anything the script added). Safe to source even if
# it doesn't exist yet (e.g. before install-dev-stack.sh's first run).
[[ -f "$HOME/.config/dev-stack/env.sh" ]] && source "$HOME/.config/dev-stack/env.sh"

# Bitwarden Secrets Manager access token, for chezmoi's `bitwardenSecrets`
# template function (the `bws` CLI) - a static machine/service-account
# token, not a personal login, so there's no interactive unlock step for
# `chezmoi apply` to prompt for (see the 2026-08-31 update in
# CHEZMOI-GUIDE.md's Bitwarden section for why this replaced `bw` there).
# Generate one in the Bitwarden web vault (Secrets Manager -> Machine
# accounts -> your account -> Access tokens -> New access token), then:
#   mkdir -p -m 700 ~/.config/bws
#   install -m 600 /dev/stdin ~/.config/bws/access-token   # paste, then Ctrl-D
# Never chezmoi-managed (same reasoning as env.sh above) - this is a live
# credential, not something that belongs in git even in a repo that's
# otherwise just retrieval logic. Safe to source even if it doesn't exist
# yet (e.g. before you've set up Secrets Manager on this machine).
if [[ -f "$HOME/.config/bws/access-token" ]]; then
  export BWS_ACCESS_TOKEN
  BWS_ACCESS_TOKEN="$(cat "$HOME/.config/bws/access-token")"
fi

if [ -d "$HOME/node_modules" ]; then
  export PATH="$HOME/node_modules/.bin:$PATH"
fi


