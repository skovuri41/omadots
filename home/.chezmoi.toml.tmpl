{{- $email := promptStringOnce . "email" "Git email address" -}}
{{- $name := promptStringOnce . "name" "Git name" -}}

[data]
    email = {{ $email | quote }}
    name = {{ $name | quote }}

# bw unlock is triggered automatically on `chezmoi apply`/`chezmoi diff` when
# BW_SESSION isn't already set, instead of needing a manual
# `export BW_SESSION=$(bw unlock --raw)` first. You'll still get an
# interactive password prompt the first time in a given shell session.
[bitwarden]
    unlock = "auto"
