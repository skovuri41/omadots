# Omarchy environment (OMARCHY_PATH + PATH), needed even for non-interactive shells
[[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap

# If not running interactively, don't do anything else (leave this above the rc source)
[[ $- != *i* ]] && return

# All the default Omarchy aliases and functions
# (don't mess with these directly - see below instead)
source "$OMARCHY_PATH/default/bash/rc"

# --- personal customizations below, managed by chezmoi ---

# Increase Bash history size and de-dupe.
export HISTSIZE='32768'
export HISTFILESIZE="${HISTSIZE}"
export HISTCONTROL='ignoreboth'
export HISTIGNORE="&:ls:[bf]g:exit:pwd:cd"
shopt -s histappend
shopt -s cdspell
shopt -s cmdhist
shopt -s nocaseglob
# append rather than overwrite - Omarchy's rc (sourced above) may already
# have set its own PROMPT_COMMAND (e.g. a starship precmd hook); a plain
# assignment here would silently discard it
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

[[ -f "$HOME/.bash_exports" ]] && source "$HOME/.bash_exports"
[[ -f "$HOME/.bash_functions" ]] && source "$HOME/.bash_functions"
[[ -f "$HOME/.bash_aliases" ]] && source "$HOME/.bash_aliases"
